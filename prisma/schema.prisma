generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("AURORA_DATABASE_URL")
}

model DocumentType {
  id            String    @id @default(uuid()) @db.Char(36)
  code          String    @unique(map: "code") @db.VarChar(20)
  name          String    @db.VarChar(50)
  country_id    String?   @db.Char(36)
  description   String?   @db.Text
  regex_pattern String?   @db.VarChar(100)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  persons       persons[]

  @@map("document_types")
}

model Ubigeo {
  id                  String                @id @default(uuid()) @db.Char(36)
  country_id          String?               @db.Char(36)
  parent_id           String?               @db.Char(36)
  level_id            String?               @db.Char(36)
  name                String                @db.VarChar(200)
  code                String?               @db.VarChar(20)
  is_active           Boolean?              @default(true)
  courier_coverages   courier_coverages[]
  couriers            couriers[]
  customer_addresses  customer_addresses[]
  motorized_coverages motorized_coverages[]
  order_shippings     order_shippings[]
  persons             persons[]
  stores              stores[]
  countries           countries?            @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ubigeos_ibfk_1")
  ubigeos             Ubigeo?               @relation("ubigeosToubigeos", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ubigeos_ibfk_2")
  other_ubigeos       Ubigeo[]              @relation("ubigeosToubigeos")
  ubigeos_levels      ubigeos_levels?       @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ubigeos_ibfk_3")

  @@index([country_id, level_id], map: "idx_ubigeos_country_level")
  @@index([parent_id], map: "idx_ubigeos_parent")
  @@index([level_id], map: "level_id")
  @@map("ubigeos")
}

model stores {
  id                     String                   @id @default(uuid()) @db.Char(36)
  legacy_store_id        BigInt?
  name                   String                   @db.VarChar(255)
  business_name          String?                  @db.VarChar(255)
  ruc                    String?                  @db.VarChar(20)
  logo_url               String?                  @db.Text
  country_id             String?                  @db.Char(36)
  ubigeo_id              String?                  @db.Char(36)
  address                String?                  @db.Text
  timezone               String?                  @db.VarChar(50)
  currency_code          String?                  @db.Char(3)
  is_active              Boolean?                 @default(true)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @updatedAt @db.Timestamp(0)
  catalogs               catalogs[]
  categories             categories[]
  customers              customers[]
  incident_types         incident_types[]
  integrations           integrations[]
  liquidations           liquidations[]
  motorized_liquidations motorized_liquidations[]
  orders                 orders[]
  products               products[]
  skus                   skus[]
  memberships            store_memberships[]
  settings               store_settings?
  countries              countries?               @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stores_ibfk_1")
  ubigeos                Ubigeo?                  @relation(fields: [ubigeo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stores_ibfk_2")
  wallets                wallets[]
  warehouse_skus         warehouse_skus[]
  warehouses             warehouses[]

  @@unique([ruc, country_id], map: "idx_store_fiscal_unique")
  @@index([country_id, is_active], map: "idx_store_by_country")
  @@index([ubigeo_id], map: "ubigeo_id")
  @@map("stores")
}

model roles {
  id               String              @id @default(uuid()) @db.Char(36)
  name             String              @unique(map: "name") @db.VarChar(50)
  description      String?             @db.VarChar(255)
  is_active        Boolean?            @default(true)
  created_at       DateTime?           @db.Timestamp(0)
  role_permissions role_permissions[]
  memberships      store_memberships[]

  @@map("roles")
}

model users {
  id                                                            String                            @id @default(uuid()) @db.Char(36)
  person_id                                                     String?                           @db.Char(36)
  email                                                         String                            @unique(map: "email") @db.VarChar(255)
  cognito_sub                                                   String?                           @unique(map: "cognito_sub") @db.VarChar(255)
  is_active                                                     Boolean?                          @default(true)
  last_login_at                                                 DateTime?                         @db.Timestamp(0)
  created_at                                                    DateTime?                         @db.Timestamp(0)
  updated_at                                                    DateTime?                         @updatedAt @db.Timestamp(0)
  kardex                                                        kardex[]
  liquidation_activity_log                                      liquidation_activity_log[]
  liquidation_exports                                           liquidation_exports[]
  motorized_incidents_motorized_incidents_reported_by_idTousers motorized_incidents[]             @relation("motorized_incidents_reported_by_idTousers")
  motorized_incidents_motorized_incidents_resolved_by_idTousers motorized_incidents[]             @relation("motorized_incidents_resolved_by_idTousers")
  motorized_liquidation_evidences                               motorized_liquidation_evidences[]
  order_status_history                                          order_status_history[]
  memberships                                                   store_memberships[]
  acceptances                                                   user_terms_acceptances[]
  person                                                        persons?                          @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")
  wallet_transactions                                           wallet_transactions[]

  @@index([person_id], map: "person_id")
  @@map("users")
}

model store_memberships {
  id            String    @id @default(uuid()) @db.Char(36)
  user_id       String?   @db.Char(36)
  store_id      String?   @db.Char(36)
  role_id       String?   @db.Char(36)
  is_owner      Boolean   @default(false)
  employee_code String?   @db.VarChar(50)
  hire_date     DateTime? @db.Date
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  user          users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "store_memberships_ibfk_1")
  store         stores?   @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "store_memberships_ibfk_2")
  role          roles?    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "store_memberships_ibfk_3")

  @@unique([user_id, store_id], name: "idx_user_store_unique")
  @@index([is_active], map: "idx_store_membership_active")
  @@index([store_id, role_id], map: "idx_store_membership_role")
  @@index([role_id], map: "role_id")
  @@map("store_memberships")
}

model Idempotency {
  id              BigInt   @id @default(autoincrement())
  idempotency_key String   @unique(map: "idempotency_key_key") @db.VarChar(255)
  status          String   @default("PROCESSED") @db.VarChar(30)
  processed_at    DateTime @default(now())
  metadata        Json?
  created_at      DateTime @default(now())

  @@index([status, created_at], map: "idempotency_status_createdAt_idx")
  @@map("idempotency")
}

model persons {
  id                     String                   @id @default(uuid()) @db.Char(36)
  legacy_person_id       BigInt?
  first_name             String?                  @db.VarChar(100)
  last_name              String?                  @db.VarChar(100)
  document_type_id       String?                  @db.Char(36)
  document_number        String?                  @unique(map: "document_number") @db.VarChar(20)
  birth_date             DateTime?                @db.Date
  ubigeo_id              String?                  @db.Char(36)
  address                String?                  @db.Text
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @updatedAt @db.Timestamp(0)
  customers              customers[]
  motorized_liquidations motorized_liquidations[]
  motorized_profiles     motorized_profiles?
  order_deliveries       order_deliveries[]
  document_types         DocumentType?            @relation(fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "persons_ibfk_1")
  ubigeos                Ubigeo?                  @relation(fields: [ubigeo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "persons_ibfk_2")
  users                  users[]

  @@unique([document_type_id, document_number], map: "idx_document_unique")
  @@index([ubigeo_id], map: "ubigeo_id")
  @@map("persons")
}

model catalogs {
  id         String     @id @default(uuid()) @db.Char(36)
  store_id   String?    @db.Char(36)
  name       String?    @db.VarChar(255)
  is_public  Boolean?   @default(false)
  created_at DateTime?  @db.Timestamp(0)
  updated_at DateTime?  @db.Timestamp(0)
  stores     stores?    @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "catalogs_ibfk_1")
  products   products[]

  @@index([store_id], map: "idx_catalog_by_store")
  @@map("catalogs")
}

model categories {
  id               String       @id @default(uuid()) @db.Char(36)
  store_id         String?      @db.Char(36)
  parent_id        String?      @db.Char(36)
  name             String?      @db.VarChar(255)
  is_active        Boolean?     @default(true)
  created_at       DateTime?    @db.Timestamp(0)
  updated_at       DateTime?    @db.Timestamp(0)
  stores           stores?      @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_ibfk_1")
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_ibfk_2")
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]

  @@index([store_id], map: "idx_categories_by_store")
  @@index([store_id, is_active], map: "idx_categories_by_store_active")
  @@index([parent_id], map: "idx_categories_parent")
  @@map("categories")
}

model countries {
  id              String            @id @default(uuid()) @db.Char(36)
  name            String            @db.VarChar(100)
  iso_code        String            @unique(map: "iso_code") @db.Char(3)
  currency_code   String?           @db.Char(3)
  timezone        String?           @db.VarChar(50)
  is_active       Boolean?          @default(true)
  couriers        couriers[]
  payment_methods payment_methods[]
  stores          stores[]
  ubigeos         Ubigeo[]
  ubigeos_levels  ubigeos_levels[]

  @@map("countries")
}

model courier_coverages {
  id                 String    @id @default(uuid()) @db.Char(36)
  courier_id         String?   @db.Char(36)
  ubigeo_id          String?   @db.Char(36)
  delivery_cost      Decimal?  @db.Decimal(12, 2)
  return_cost        Decimal?  @db.Decimal(12, 2)
  additional_cost    Decimal?  @db.Decimal(12, 2)
  allow_cod_override Boolean?  @default(false)
  max_cod_amount     Decimal?  @db.Decimal(12, 2)
  is_active          Boolean?  @default(true)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  couriers           couriers? @relation(fields: [courier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "courier_coverages_ibfk_1")
  ubigeos            Ubigeo?   @relation(fields: [ubigeo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "courier_coverages_ibfk_2")

  @@unique([courier_id, ubigeo_id], map: "idx_coverage_unique")
  @@index([ubigeo_id, is_active], map: "idx_coverage_by_location")
  @@map("courier_coverages")
}

model couriers {
  id                            String                          @id @default(uuid()) @db.Char(36)
  legacy_transporter_id         BigInt?
  name                          String                          @db.VarChar(255)
  country_id                    String?                         @db.Char(36)
  ubigeo_id                     String?                         @db.Char(36)
  url_image                     String?                         @db.Text
  support_phone                 String?                         @db.VarChar(50)
  support_email                 String?                         @db.VarChar(255)
  is_require_gps                Boolean?                        @default(false)
  flag_delivery_express         Boolean?                        @default(false)
  sunday_delivery               Boolean?                        @default(false)
  is_active                     Boolean?                        @default(true)
  created_at                    DateTime?                       @db.Timestamp(0)
  updated_at                    DateTime?                       @db.Timestamp(0)
  courier_coverages             courier_coverages[]
  countries                     countries?                      @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "couriers_ibfk_1")
  ubigeos                       Ubigeo?                         @relation(fields: [ubigeo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "couriers_ibfk_2")
  motorized_liquidation_details motorized_liquidation_details[]
  motorized_profiles            motorized_profiles[]
  order_deliveries              order_deliveries[]
  order_shippings               order_shippings[]

  @@index([country_id, is_active], map: "idx_couriers_by_country")
  @@index([ubigeo_id], map: "ubigeo_id")
  @@map("couriers")
}

model customer_addresses {
  id           String     @id @default(uuid()) @db.Char(36)
  customer_id  String?    @db.Char(36)
  address      String     @db.Text
  reference    String?    @db.Text
  ubigeo_id    String?    @db.Char(36)
  country_code String     @db.Char(3)
  lat          Decimal?   @db.Decimal(10, 7)
  lng          Decimal?   @db.Decimal(10, 7)
  is_default   Boolean?   @default(false)
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  customers    customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_addresses_ibfk_1")
  ubigeos      Ubigeo?    @relation(fields: [ubigeo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customer_addresses_ibfk_2")

  @@index([country_code], map: "idx_addresses_by_country")
  @@index([customer_id], map: "idx_addresses_by_customer")
  @@index([ubigeo_id], map: "ubigeo_id")
  @@map("customer_addresses")
}

model customers {
  id                 String               @id @default(uuid()) @db.Char(36)
  legacy_customer_id BigInt?
  store_id           String?              @db.Char(36)
  person_id          String?              @db.Char(36)
  email              String?              @db.VarChar(255)
  phone              String?              @db.VarChar(50)
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  customer_addresses customer_addresses[]
  stores             stores?              @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_ibfk_1")
  persons            persons?             @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_ibfk_2")
  orders             orders[]

  @@unique([store_id, email], map: "idx_customer_email_per_store")
  @@unique([store_id, person_id], map: "idx_unique_store_customer")
  @@index([store_id, is_active], map: "idx_active_customers")
  @@index([person_id], map: "person_id")
  @@map("customers")
}

model delivery_statuses {
  id               String             @id @default(uuid()) @db.Char(36)
  code             String             @unique(map: "code") @db.VarChar(20)
  label            String             @db.VarChar(50)
  description      String?            @db.Text
  color            String?            @db.VarChar(7)
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  order_deliveries order_deliveries[]

  @@index([is_active], map: "idx_delivery_statuses_active")
  @@index([code], map: "idx_delivery_statuses_code")
  @@map("delivery_statuses")
}

model incident_types {
  id                  String                @id @default(uuid()) @db.Char(36)
  store_id            String?               @db.Char(36)
  code                String                @unique(map: "code") @db.VarChar(20)
  label               String                @db.VarChar(100)
  description         String?               @db.Text
  default_discount    Decimal?              @default(0.00) @db.Decimal(12, 2)
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?             @default(now()) @db.Timestamp(0)
  stores              stores?               @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "incident_types_ibfk_1")
  motorized_incidents motorized_incidents[]

  @@index([code], map: "idx_incident_types_code")
  @@index([store_id], map: "idx_incident_types_store")
  @@map("incident_types")
}

model integration_webhooks {
  id             String        @id @default(uuid()) @db.Char(36)
  integration_id String?       @db.Char(36)
  event_type     String        @db.VarChar(100)
  payload        Json?
  processed_at   DateTime?     @db.Timestamp(0)
  created_at     DateTime?     @default(now()) @db.Timestamp(0)
  integrations   integrations? @relation(fields: [integration_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "integration_webhooks_ibfk_1")

  @@index([event_type, processed_at], map: "idx_webhooks_event_processed")
  @@index([integration_id, event_type], map: "idx_webhooks_integration_event")
  @@map("integration_webhooks")
}

model integrations {
  id                   String                 @id @default(uuid()) @db.Char(36)
  store_id             String?                @db.Char(36)
  type                 String                 @db.VarChar(50)
  is_active            Boolean?               @default(true)
  config               Json?
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  integration_webhooks integration_webhooks[]
  stores               stores?                @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "integrations_ibfk_1")

  @@unique([store_id, type], map: "idx_integration_store_type")
}

model inventory {
  id                String      @id @default(uuid()) @db.Char(36)
  warehouse_id      String?     @db.Char(36)
  sku_id            String?     @db.Char(36)
  quantity_on_hand  Int         @default(0)
  quantity_reserved Int         @default(0)
  created_at        DateTime?   @default(now()) @db.Timestamp(0)
  updated_at        DateTime?   @default(now()) @db.Timestamp(0)
  warehouses        warehouses? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_ibfk_1")
  skus              skus?       @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_ibfk_2")

  @@unique([warehouse_id, sku_id], map: "idx_warehouse_sku_unique")
  @@index([warehouse_id, quantity_on_hand], map: "idx_inventory_by_stock")
  @@index([sku_id], map: "sku_id")
  @@map("inventory")
}

model kardex {
  id                    String                 @id @default(uuid()) @db.Char(36)
  warehouse_id          String?                @db.Char(36)
  sku_id                String?                @db.Char(36)
  type_movement_id      String?                @db.Char(36)
  status_kardex_id      String?                @db.Char(36)
  quantity              Int
  reference             String?                @db.VarChar(255)
  performed_by_id       String?                @db.Char(36)
  created_at            DateTime?              @db.Timestamp(0)
  warehouses            warehouses?            @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "kardex_ibfk_1")
  skus                  skus?                  @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "kardex_ibfk_2")
  kardex_movement_types kardex_movement_types? @relation(fields: [type_movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "kardex_ibfk_3")
  kardex_statuses       kardex_statuses?       @relation(fields: [status_kardex_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "kardex_ibfk_4")
  users                 users?                 @relation(fields: [performed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "kardex_ibfk_5")

  @@index([reference], map: "idx_kardex_by_reference")
  @@index([warehouse_id, sku_id, created_at], map: "idx_kardex_by_sku_date")
  @@index([performed_by_id], map: "performed_by_id")
  @@index([status_kardex_id], map: "status_kardex_id")
  @@index([type_movement_id], map: "type_movement_id")
  @@index([sku_id, warehouse_id, created_at], map: "idx_kardex_sku_date")
  @@map("kardex")
}

model kardex_movement_types {
  id                  String   @id @default(uuid()) @db.Char(36)
  code                String   @unique(map: "code") @db.VarChar(20)
  name                String   @db.VarChar(50)
  description         String?  @db.Text
  is_system_generated Boolean? @default(false)
  kardex              kardex[]

  @@map("kardex_movement_types")
}

model kardex_statuses {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique(map: "code") @db.VarChar(20)
  name        String   @db.VarChar(50)
  description String?  @db.Text
  kardex      kardex[]

  @@map("kardex_statuses")
}

model liquidation_activity_log {
  id             String        @id @default(uuid()) @db.Char(36)
  liquidation_id String?       @db.Char(36)
  action         String        @db.VarChar(50)
  performed_by   String?       @db.Char(36)
  details        Json?
  created_at     DateTime?     @default(now()) @db.Timestamp(0)
  liquidations   liquidations? @relation(fields: [liquidation_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "liquidation_activity_log_ibfk_1")
  users          users?        @relation(fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "liquidation_activity_log_ibfk_2")

  @@index([liquidation_id], map: "liquidation_id")
  @@index([performed_by], map: "performed_by")
  @@map("liquidation_activity_log")
}

model liquidation_details {
  id                String        @id @default(uuid()) @db.Char(36)
  liquidation_id    String?       @db.Char(36)
  order_id          String?       @db.Char(36)
  sku_id            String?       @db.Char(36)
  quantity          Int
  unit_price        Decimal       @db.Decimal(12, 2)
  total_amount      Decimal       @db.Decimal(12, 2)
  commission_rate   Decimal       @db.Decimal(5, 4)
  commission_amount Decimal       @db.Decimal(12, 2)
  net_amount        Decimal       @db.Decimal(12, 2)
  created_at        DateTime?     @default(now()) @db.Timestamp(0)
  liquidations      liquidations? @relation(fields: [liquidation_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "liquidation_details_ibfk_1")
  orders            orders?       @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "liquidation_details_ibfk_2")
  skus              skus?         @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "liquidation_details_ibfk_3")

  @@index([liquidation_id], map: "liquidation_id")
  @@index([order_id], map: "order_id")
  @@index([sku_id], map: "sku_id")
  @@map("liquidation_details")
}

model liquidation_exports {
  id             String        @id @default(uuid()) @db.Char(36)
  liquidation_id String?       @db.Char(36)
  file_url       String        @db.VarChar(500)
