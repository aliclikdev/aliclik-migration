model TrackingEvent {
  id                     BigInt    @id @default(autoincrement())
  order_id               BigInt    @map("order_id")
  tracking_event_type_id BigInt    @map("tracking_event_type_id")
  user_id                BigInt?   @map("user_id")
  description            String?   @db.Text
  metadata               Json?
  location               String?   @db.VarChar(255)
  lat                    Decimal?  @db.Decimal(10, 7)
  lng                    Decimal?  @db.Decimal(10, 7)
  created_at             DateTime? @default(now()) @db.Timestamp(0)

  // Relaciones
  orders               Order             @relation(fields: [order_id], references: [id], onDelete: Cascade)
  tracking_event_types TrackingEventType @relation(fields: [tracking_event_type_id], references: [id])
  users                User?             @relation(fields: [user_id], references: [id])

  @@index([order_id])
  @@index([tracking_event_type_id])
  @@index([created_at])
  @@map("tracking_events")
}
