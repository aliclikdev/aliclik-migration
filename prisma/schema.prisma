generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("AURORA_DATABASE_URL")
}

model Country {
  id              BigInt          @id @default(autoincrement())
  name            String          @db.VarChar(100)
  iso_code        String          @unique @db.Char(3)
  currency_code   String?         @db.Char(3)
  timezone        String?         @db.VarChar(50)
  is_active       Boolean?        @default(true)
  couriers        Courier[]
  DocumentType    DocumentType[]
  payment_methods PaymentMethod[]
  stores          Store[]
  ubigeos         Ubigeo[]
  ubigeos_levels  UbigeosLevel[]

  @@map("countries")
}

model DocumentType {
  id            BigInt    @id @default(autoincrement())
  code          String    @unique @db.VarChar(20)
  name          String    @db.VarChar(50)
  country_id    BigInt?   @map("country_id")
  description   String?   @db.Text
  regex_pattern String?   @db.VarChar(100)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  countries     Country?  @relation(fields: [country_id], references: [id])
  persons       Person[]

  @@index([country_id], map: "document_types_country_id_fkey")
  @@map("document_types")
}

model OrderStatus {
  id                            BigInt               @id @default(autoincrement())
  code                          String               @unique @db.VarChar(50)
  label                         String               @db.VarChar(100)
  description                   String?              @db.VarChar(255)
  color                         String?              @db.VarChar(7)
  order_status_history_new      OrderStatusHistory[] @relation("newStatus")
  order_status_history_previous OrderStatusHistory[] @relation("previousStatus")
  orders                        Order[]

  @@map("order_statuses")
}

model DeliveryStatus {
  id               BigInt          @id @default(autoincrement())
  code             String          @unique @db.VarChar(20)
  label            String          @db.VarChar(50)
  description      String?         @db.Text
  color            String?         @db.VarChar(7)
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamp(0)
  updated_at       DateTime?       @default(now()) @db.Timestamp(0)
  order_deliveries OrderDelivery[]

  @@map("delivery_statuses")
}

model PaymentStatus {
  id             BigInt         @id @default(autoincrement())
  code           String         @unique @db.VarChar(50)
  label          String         @db.VarChar(100)
  description    String?        @db.VarChar(255)
  order_payments OrderPayment[]
  Order          Order[]

  @@map("payment_statuses")
}

model ShippingStatus {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(50)
  label       String  @db.VarChar(100)
  description String? @db.VarChar(255)
  orders      Order[]

  @@map("shipping_statuses")
}

model ManagementType {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(20)
  label       String  @db.VarChar(100)
  description String? @db.VarChar(255)
  orders      Order[]

  @@map("management_types")
}

model AccountType {
  id            BigInt        @id @default(autoincrement())
  code          String        @unique @db.VarChar(20)
  label         String        @db.VarChar(100)
  description   String?       @db.Text
  is_active     Boolean?      @default(true)
  bank_accounts BankAccount[]

  @@map("account_types")
}

model ProductStatus {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @db.VarChar(20)
  label       String    @db.VarChar(50)
  description String?   @db.Text
  products    Product[]

  @@map("product_statuses")
}

model LiquidationStatus {
  id                     BigInt                 @id @default(autoincrement())
  code                   String                 @unique @db.VarChar(50)
  label                  String                 @db.VarChar(100)
  description            String?                @db.VarChar(255)
  liquidations           Liquidation[]
  motorized_liquidations MotorizedLiquidation[]

  @@map("liquidation_statuses")
}

model UbigeosLevel {
  id          BigInt   @id @default(autoincrement())
  country_id  BigInt?  @map("country_id")
  level       Int
  name        String   @db.VarChar(50)
  description String?  @db.Text
  is_active   Boolean? @default(true)
  ubigeos     Ubigeo[]
  countries   Country? @relation(fields: [country_id], references: [id])

  @@unique([country_id, level])
  @@map("ubigeos_levels")
}

model Ubigeo {
  id                  BigInt              @id @default(autoincrement())
  country_id          BigInt?             @map("country_id")
  parent_id           BigInt?             @map("parent_id")
  level_id            BigInt?             @map("level_id")
  name                String              @db.VarChar(200)
  code                String?             @db.VarChar(20)
  is_active           Boolean?            @default(true)
  courier_coverages   CourierCoverage[]
  couriers            Courier[]
  customer_addresses  CustomerAddress[]
  motorized_coverages MotorizedCoverage[]
  order_shippings     OrderShipping[]
  persons             Person[]
  stores              Store[]
  countries           Country?            @relation(fields: [country_id], references: [id])
  ubigeos_levels      UbigeosLevel?       @relation(fields: [level_id], references: [id])
  parent              Ubigeo?             @relation("UbigeoParent", fields: [parent_id], references: [id])
  children            Ubigeo[]            @relation("UbigeoParent")

  @@index([country_id, level_id])
  @@index([parent_id])
  @@index([level_id], map: "ubigeos_level_id_fkey")
  @@map("ubigeos")
}

model Store {
  id                     BigInt                 @id @default(autoincrement())
  legacy_store_id        BigInt?                @map("legacy_store_id")
  name                   String                 @db.VarChar(255)
  business_name          String?                @db.VarChar(255)
  ruc                    String?                @db.VarChar(20)
  logo_url               String?                @db.Text
  country_id             BigInt?                @map("country_id")
  ubigeo_id              BigInt?                @map("ubigeo_id")
  address                String?                @db.Text
  timezone               String?                @db.VarChar(50)
  currency_code          String?                @db.Char(3)
  is_active              Boolean?               @default(true)
  created_at             DateTime?              @db.Timestamp(0)
  updated_at             DateTime?              @db.Timestamp(0)
  bank_accounts          BankAccount[]
  catalogs               Catalog[]
  categories             Category[]
  customers              Customer[]
  incident_types         IncidentType[]
  integrations           Integration[]
  liquidations           Liquidation[]
  motorized_liquidations MotorizedLiquidation[]
  orders                 Order[]
  products               Product[]
  skus                   Sku[]
  store_memberships      StoreMembership[]
  store_settings         StoreSetting?
  countries              Country?               @relation(fields: [country_id], references: [id])
  ubigeos                Ubigeo?                @relation(fields: [ubigeo_id], references: [id])
  wallets                Wallet[]
  WarehouseSku           WarehouseSku[]
  warehouses             Warehouse[]

  @@unique([ruc, country_id])
  @@index([country_id, is_active])
  @@index([ubigeo_id], map: "stores_ubigeo_id_fkey")
  @@map("stores")
}

model Person {
  id                     BigInt                 @id @default(autoincrement())
  legacy_person_id       BigInt?                @map("legacy_person_id")
  first_name             String?                @db.VarChar(100)
  last_name              String?                @db.VarChar(100)
  document_type_id       BigInt?                @map("document_type_id")
  document_number        String?                @unique @db.VarChar(20)
  birth_date             DateTime?              @db.Date
  ubigeo_id              BigInt?                @map("ubigeo_id")
  address                String?                @db.Text
  created_at             DateTime?              @db.Timestamp(0)
  updated_at             DateTime?              @db.Timestamp(0)
  customers              Customer[]
  motorized_liquidations MotorizedLiquidation[]
  motorized_profiles     MotorizedProfile?
  order_deliveries       OrderDelivery[]
  document_types         DocumentType?          @relation(fields: [document_type_id], references: [id])
  ubigeos                Ubigeo?                @relation(fields: [ubigeo_id], references: [id])
  users                  User[]

  @@unique([document_type_id, document_number])
  @@index([ubigeo_id], map: "persons_ubigeo_id_fkey")
  @@map("persons")
}

model User {
  id                              BigInt                         @id @default(autoincrement())
  person_id                       BigInt?                        @map("person_id")
  email                           String                         @unique @db.VarChar(255)
  cognito_sub                     String?                        @unique @db.VarChar(255)
  is_active                       Boolean?                       @default(true)
  last_login_at                   DateTime?                      @db.Timestamp(0)
  created_at                      DateTime?                      @db.Timestamp(0)
  updated_at                      DateTime?                      @db.Timestamp(0)
  kardex                          Kardex[]
  liquidation_activity_log        LiquidationActivityLog[]
  liquidation_exports             LiquidationExport[]
  motorized_incidents_reported    MotorizedIncident[]            @relation("reportedBy")
  motorized_incidents_resolved    MotorizedIncident[]            @relation("resolvedBy")
  motorized_liquidation_evidences MotorizedLiquidationEvidence[]
  order_status_history            OrderStatusHistory[]
  store_memberships               StoreMembership[]
  user_terms_acceptances          UserTermsAcceptance[]
  persons                         Person?                        @relation(fields: [person_id], references: [id])
  wallet_transactions             WalletTransaction[]
  TrackingEvent                   TrackingEvent[]

  @@index([person_id], map: "users_person_id_fkey")
  @@map("users")
}

model Customer {
  id                 BigInt            @id @default(autoincrement())
  legacy_customer_id BigInt?           @map("legacy_customer_id")
  store_id           BigInt?           @map("store_id")
  person_id          BigInt?           @map("person_id")
  email              String?           @db.VarChar(255)
  phone              String?           @db.VarChar(50)
  is_active          Boolean?          @default(true)
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  customer_addresses CustomerAddress[]
  persons            Person?           @relation(fields: [person_id], references: [id])
  stores             Store?            @relation(fields: [store_id], references: [id])
  orders             Order[]

  @@unique([store_id, email])
  @@unique([store_id, person_id])
  @@index([store_id, is_active])
  @@index([person_id], map: "customers_person_id_fkey")
  @@map("customers")
}

model Order {
  id                            BigInt                       @id @default(autoincrement())
  legacy_order_id               BigInt?                      @map("legacy_order_id")
  store_id                      BigInt?                      @map("store_id")
  customer_id                   BigInt?                      @map("customer_id")
  warehouse_id                  BigInt?                      @map("warehouse_id")
  status_id                     BigInt?                      @map("status_id")
  payment_status_id             BigInt?                      @map("payment_status_id")
  shipping_status_id            BigInt?                      @map("shipping_status_id")
  management_type_id            BigInt?                      @map("management_type_id")
  order_number                  String                       @unique @db.VarChar(50)
  channel                       String?                      @default("WEB") @db.VarChar(50)
  subtotal                      Decimal                      @db.Decimal(12, 2)
  tax_amount                    Decimal?                     @default(0.00) @db.Decimal(12, 2)
  discount_amount               Decimal?                     @default(0.00) @db.Decimal(12, 2)
  total                         Decimal                      @db.Decimal(12, 2)
  fulfillment_platform          String?                      @db.VarChar(50)
  fulfillment_cost              Decimal?                     @default(0.00) @db.Decimal(12, 2)
  drop_cost                     Decimal?                     @default(0.00) @db.Decimal(12, 2)
  cash_amount                   Decimal?                     @default(0.00) @db.Decimal(12, 2)
  transfer_amount               Decimal?                     @default(0.00) @db.Decimal(12, 2)
  pos_amount                    Decimal?                     @default(0.00) @db.Decimal(12, 2)
  currency_code                 String                       @db.Char(3)
  external_order_id             String?                      @unique @db.VarChar(100)
  note                          String?                      @db.Text
  created_at                    DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                    DateTime?                    @default(now()) @db.Timestamp(0)
  liquidation_details           LiquidationDetail[]
  motorized_liquidation_details MotorizedLiquidationDetail[]
  order_deliveries              OrderDelivery[]
  order_details                 OrderDetail[]
  order_payments                OrderPayment[]
  order_shippings               OrderShipping?
  order_status_history          OrderStatusHistory[]
  tracking_events               TrackingEvent[]
  customers                     Customer?                    @relation(fields: [customer_id], references: [id])
  management_types              ManagementType?              @relation(fields: [management_type_id], references: [id])
  payment_statuses              PaymentStatus?               @relation(fields: [payment_status_id], references: [id])
  shipping_statuses             ShippingStatus?              @relation(fields: [shipping_status_id], references: [id])
  order_statuses                OrderStatus?                 @relation(fields: [status_id], references: [id])
  stores                        Store?                       @relation(fields: [store_id], references: [id])
  warehouses                    Warehouse?                   @relation(fields: [warehouse_id], references: [id])

  @@unique([store_id, order_number])
  @@index([customer_id, created_at])
  @@index([currency_code])
  @@index([management_type_id])
  @@index([fulfillment_platform])
  @@index([store_id, created_at])
  @@index([store_id, status_id, created_at])
  @@index([status_id, created_at])
  @@index([payment_status_id], map: "orders_payment_status_id_fkey")
  @@index([shipping_status_id], map: "orders_shipping_status_id_fkey")
  @@index([warehouse_id], map: "orders_warehouse_id_fkey")
  @@map("orders")
}

model OrderDetail {
  id                    BigInt    @id @default(autoincrement())
  order_id              BigInt?   @map("order_id")
  product_id            BigInt?   @map("product_id")
  product_name          String    @db.VarChar(255)
  sku_id                BigInt?   @map("sku_id")
  sku_code              String    @db.VarChar(50)
  quantity              Int
  delivered_quantity    Int?      @default(0)
  unit_price            Decimal   @db.Decimal(12, 2)
  discount_amount       Decimal?  @default(0.00) @db.Decimal(12, 2)
  tax_amount            Decimal?  @default(0.00) @db.Decimal(12, 2)
  total                 Decimal   @db.Decimal(12, 2)
  drop_unit_cost        Decimal?  @default(0.00) @db.Decimal(12, 2)
  drop_total            Decimal?  @default(0.00) @db.Decimal(12, 2)
  fulfillment_unit_cost Decimal?  @default(0.00) @db.Decimal(12, 2)
  currency_code         String    @db.Char(3)
  notes                 String?   @db.Text
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  orders                Order?    @relation(fields: [order_id], references: [id])
  products              Product?  @relation(fields: [product_id], references: [id])
  skus                  Sku?      @relation(fields: [sku_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([sku_id])
  @@map("order_details")
}

model OrderShipping {
  id                            BigInt                       @id @default(autoincrement())
  order_id                      BigInt?                      @unique @map("order_id")
  address                       String                       @db.Text
  reference                     String?                      @db.Text
  ubigeo_id                     BigInt?                      @map("ubigeo_id")
  country_code                  String                       @db.Char(3)
  lat                           Decimal                      @db.Decimal(10, 7)
  lng                           Decimal                      @db.Decimal(10, 7)
  courier_id                    BigInt?                      @map("courier_id")
  tracking_number               String?                      @db.VarChar(100)
  shipping_cost                 Decimal                      @db.Decimal(12, 2)
  discount_amount               Decimal?                     @default(0.00) @db.Decimal(12, 2)
  cod_amount                    Decimal?                     @default(0.00) @db.Decimal(12, 2)
  agency_origin_name            String?                      @db.VarChar(255)
  agency_destination_name       String?                      @db.VarChar(255)
  guide_series                  String?                      @db.VarChar(50)
  key_code                      String?                      @unique @db.VarChar(100)
  shalom_service_type           String?                      @db.VarChar(50)
  shalom_package_type           String?                      @db.VarChar(50)
  contact_document_type         String?                      @db.VarChar(20)
  contact_document_number       String?                      @db.VarChar(50)
  merchandise_description       String?                      @db.VarChar(500)
  declared_value                Decimal?                     @default(0.00) @db.Decimal(12, 2)
  is_automatic_guide            Boolean?                     @default(false)
  schedule_date                 DateTime?                    @db.Timestamp(0)
  estimated_delivery_date       DateTime?                    @db.Timestamp(0)
  dispatch_date                 DateTime?                    @db.Timestamp(0)
  delivered_at                  DateTime?                    @db.Timestamp(0)
  notes                         String?                      @db.Text
  created_at                    DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                    DateTime?                    @default(now()) @db.Timestamp(0)
  motorized_liquidation_details MotorizedLiquidationDetail[]
  couriers                      Courier?                     @relation(fields: [courier_id], references: [id])
  orders                        Order?                       @relation(fields: [order_id], references: [id])
  ubigeos                       Ubigeo?                      @relation(fields: [ubigeo_id], references: [id])

  @@index([country_code, schedule_date])
  @@index([courier_id, tracking_number])
  @@index([key_code])
  @@index([dispatch_date])
  @@index([estimated_delivery_date])
  @@index([shalom_service_type])
  @@index([ubigeo_id], map: "order_shippings_ubigeo_id_fkey")
  @@map("order_shippings")
}

model OrderDelivery {
  id                            BigInt                       @id @default(autoincrement())
  order_id                      BigInt?                      @map("order_id")
  person_id                     BigInt?                      @map("person_id")
  courier_id                    BigInt?                      @map("courier_id")
  delivery_status_id            BigInt?                      @map("delivery_status_id")
  schedule_date                 DateTime?                    @db.Timestamp(0)
  actual_delivery_date          DateTime?                    @db.Timestamp(0)
  notes                         String?                      @db.Text
  created_at                    DateTime?                    @default(now()) @db.Timestamp(0)
  motorized_liquidation_details MotorizedLiquidationDetail[]
  couriers                      Courier?                     @relation(fields: [courier_id], references: [id])
  delivery_statuses             DeliveryStatus?              @relation(fields: [delivery_status_id], references: [id])
  orders                        Order?                       @relation(fields: [order_id], references: [id])
  persons                       Person?                      @relation(fields: [person_id], references: [id])

  @@index([delivery_status_id, created_at])
  @@index([courier_id, delivery_status_id])
  @@index([person_id, created_at])
  @@index([order_id, created_at])
  @@map("order_deliveries")
}

model OrderPayment {
  id                BigInt         @id @default(autoincrement())
  order_id          BigInt?        @map("order_id")
  payment_method_id BigInt?        @map("payment_method_id")
  amount            Decimal        @db.Decimal(12, 2)
  payment_status_id BigInt?        @map("payment_status_id")
  operation_code    String?        @db.VarChar(50)
  transaction_id    String?        @db.VarChar(100)
  paid_at           DateTime?      @db.Timestamp(0)
  created_at        DateTime?      @default(now()) @db.Timestamp(0)
  orders            Order?         @relation(fields: [order_id], references: [id])
  payment_methods   PaymentMethod? @relation(fields: [payment_method_id], references: [id])
  payment_statuses  PaymentStatus? @relation(fields: [payment_status_id], references: [id])

  @@index([order_id])
  @@index([paid_at])
  @@index([payment_method_id, paid_at])
  @@index([payment_status_id], map: "order_payments_payment_status_id_fkey")
  @@map("order_payments")
}

model OrderStatusHistory {
  id                 BigInt       @id @default(autoincrement())
  order_id           BigInt?      @map("order_id")
  previous_status_id BigInt?      @map("previous_status_id")
  new_status_id      BigInt?      @map("new_status_id")
  changed_by_id      BigInt?      @map("changed_by_id")
  comment            String?      @db.Text
  created_at         DateTime?    @default(now()) @db.Timestamp(0)
  users              User?        @relation(fields: [changed_by_id], references: [id])
  new_status         OrderStatus? @relation("newStatus", fields: [new_status_id], references: [id])
  orders             Order?       @relation(fields: [order_id], references: [id])
  previous_status    OrderStatus? @relation("previousStatus", fields: [previous_status_id], references: [id])

  @@index([order_id, created_at])
  @@index([new_status_id, created_at])
  @@index([changed_by_id], map: "order_status_history_changed_by_id_fkey")
  @@index([previous_status_id], map: "order_status_history_previous_status_id_fkey")
  @@map("order_status_history")
}

model Product {
  id                     BigInt           @id @default(autoincrement())
  legacy_product_id      BigInt?          @map("legacy_product_id")
  store_id               BigInt?          @map("store_id")
  category_id            BigInt?          @map("category_id")
  catalog_id             BigInt?          @map("catalog_id")
  name                   String           @db.VarChar(255)
  short_description      String?          @db.Text
  large_description      String?          @db.Text
  url_image              String?          @db.Text
  is_product_global      Boolean?         @default(false)
  sale_price_drop        Decimal?         @default(0.00) @db.Decimal(12, 2)
  price_drop_crate       Decimal?         @default(0.00) @db.Decimal(12, 2)
  price_drop_dozen       Decimal?         @default(0.00) @db.Decimal(12, 2)
  retail_price_suggested Decimal?         @default(0.00) @db.Decimal(12, 2)
  units_crate            Int?             @default(0)
  url_reference          String?          @db.Text
  is_novelty             Boolean?         @default(false)
  is_large_volume        Boolean?         @default(false)
  is_validate            Boolean?         @default(false)
  is_registered_product  Boolean?         @default(false)
  description            String?          @db.Text
  status_id              BigInt?          @map("status_id")
  is_active              Boolean?         @default(true)
  created_at             DateTime?        @db.Timestamp(0)
  updated_at             DateTime?        @db.Timestamp(0)
  order_details          OrderDetail[]
  product_images         ProductImage[]
  product_variants       ProductVariant[]
  catalogs               Catalog?         @relation(fields: [catalog_id], references: [id])
  categories             Category?        @relation(fields: [category_id], references: [id])
  product_statuses       ProductStatus?   @relation(fields: [status_id], references: [id])
  stores                 Store?           @relation(fields: [store_id], references: [id])
  skus                   Sku[]

  @@index([category_id])
  @@index([store_id, status_id])
  @@index([store_id])
  @@index([store_id, is_active])
  @@index([catalog_id], map: "products_catalog_id_fkey")
  @@index([status_id], map: "products_status_id_fkey")
  @@map("products")
}

model Sku {
  id                  BigInt              @id @default(autoincrement())
  legacy_sku_id       BigInt?             @map("legacy_sku_id")
  store_id            BigInt?             @map("store_id")
  product_id          BigInt?             @map("product_id")
  sku_code            String              @db.VarChar(50)
  ean                 String?             @unique @db.VarChar(30)
  regular_price       Decimal             @db.Decimal(12, 2)
  sales_price         Decimal             @db.Decimal(12, 2)
  purchase_price      Decimal             @db.Decimal(12, 2)
  drop_price          Decimal?            @db.Decimal(12, 2)
  height_cm           Decimal?            @db.Decimal(8, 2)
  width_cm            Decimal?            @db.Decimal(8, 2)
  length_cm           Decimal?            @db.Decimal(8, 2)
  weight_kg           Decimal?            @db.Decimal(8, 2)
  stock_min           Int?                @default(5)
  stock_max           Int?                @default(100)
  track_stock         Boolean?            @default(true)
  allow_backorder     Boolean?            @default(false)
  is_active           Boolean?            @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamp(0)
  updated_at          DateTime?           @default(now()) @db.Timestamp(0)
  inventory           Inventory[]
  kardex              Kardex[]
  liquidation_details LiquidationDetail[]
  order_details       OrderDetail[]
  sku_variant_options SkuVariantOption[]
  products            Product?            @relation(fields: [product_id], references: [id])
  stores              Store?              @relation(fields: [store_id], references: [id])
  warehouse_skus      WarehouseSku[]

  @@unique([product_id, sku_code])
  @@unique([store_id, sku_code])
  @@index([ean])
  @@index([store_id, is_active])
  @@map("skus")
}

model ProductVariant {
  id                BigInt          @id @default(autoincrement())
  legacy_variant_id BigInt?         @map("legacy_variant_id")
  product_id        BigInt?         @map("product_id")
  name              String          @db.VarChar(100)
  products          Product?        @relation(fields: [product_id], references: [id])
  variant_options   VariantOption[]

  @@unique([product_id, legacy_variant_id])
  @@index([product_id])
  @@map("product_variants")
}

model VariantOption {
  id                  BigInt             @id @default(autoincrement())
  legacy_option_id    BigInt?            @map("legacy_option_id")
  variant_id          BigInt?            @map("variant_id")
  name                String             @db.VarChar(100)
  sku_variant_options SkuVariantOption[]
  product_variants    ProductVariant?    @relation(fields: [variant_id], references: [id])

  @@unique([variant_id, legacy_option_id])
  @@index([variant_id])
  @@map("variant_options")
}

model SkuVariantOption {
  id                BigInt         @id @default(autoincrement())
  sku_id            BigInt?        @map("sku_id")
  variant_option_id BigInt?        @map("variant_option_id")
  skus              Sku?           @relation(fields: [sku_id], references: [id])
  variant_options   VariantOption? @relation(fields: [variant_option_id], references: [id])

  @@unique([sku_id, variant_option_id])
  @@index([variant_option_id], map: "sku_variant_options_variant_option_id_fkey")
  @@map("sku_variant_options")
}

model ProductImage {
  id         BigInt    @id @default(autoincrement())
  product_id BigInt    @map("product_id")
  url        String    @db.VarChar(500)
  title      String?   @db.VarChar(255)
  alt_text   String?   @db.VarChar(255)
  position   Int       @default(0)
  is_primary Boolean?  @default(false)
  image_type String    @default("PRODUCT") @db.VarChar(20)
  width      Int?
  height     Int?
  file_size  Int?
  mime_type  String?   @db.VarChar(50)
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  products   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, is_active])
  @@index([product_id, position])
  @@index([product_id, is_primary])
  @@index([product_id, image_type, position])
  @@map("product_images")
}

model Warehouse {
  id                  BigInt            @id @default(autoincrement())
  store_id            BigInt            @map("store_id")
  warehouse_legacy_id BigInt?           @map("warehouse_legacy_id")
  name                String?           @db.VarChar(255)
  address             String?           @db.Text
  ubigeo_id           BigInt?           @map("ubigeo_id")
  lat                 Decimal?          @db.Decimal(10, 7)
  lng                 Decimal?          @db.Decimal(10, 7)
  is_active           Boolean?          @default(true)
  created_at          DateTime?         @default(now()) @db.Timestamp(0)
  updated_at          DateTime?         @db.Timestamp(0)
  inventory           Inventory[]
  kardex              Kardex[]
  orders              Order[]
  warehouse_settings  WarehouseSetting?
  warehouse_skus      WarehouseSku[]
  stores              Store             @relation(fields: [store_id], references: [id])

  @@index([store_id])
  @@index([store_id, is_active])
  @@map("warehouses")
}

model Inventory {
  id                BigInt     @id @default(autoincrement())
  warehouse_id      BigInt?    @map("warehouse_id")
  sku_id            BigInt?    @map("sku_id")
  quantity_on_hand  Int        @default(0)
  quantity_reserved Int        @default(0)
  created_at        DateTime?  @default(now()) @db.Timestamp(0)
  updated_at        DateTime?  @default(now()) @db.Timestamp(0)
  skus              Sku?       @relation(fields: [sku_id], references: [id])
  warehouses        Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@unique([warehouse_id, sku_id])
  @@index([warehouse_id, quantity_on_hand])
  @@index([sku_id], map: "inventory_sku_id_fkey")
  @@map("inventory")
}

model WarehouseSku {
  id                      BigInt     @id @default(autoincrement())
  legacy_warehouse_sku_id BigInt?    @map("legacy_warehouse_sku_id")
  store_id                BigInt?    @map("store_id")
  sku_id                  BigInt?    @map("sku_id")
  warehouse_id            BigInt?    @map("warehouse_id")
  stock_physical          Int?       @default(0)
  stock_virtual           Int?       @default(0)
  stock_reserved          Int?       @default(0)
  created_at              DateTime?  @default(now()) @db.Timestamp(0)
  updated_at              DateTime?  @default(now()) @db.Timestamp(0)
  skus                    Sku?       @relation(fields: [sku_id], references: [id])
  stores                  Store?     @relation(fields: [store_id], references: [id])
  warehouses              Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@unique([sku_id, warehouse_id])
  @@index([warehouse_id, stock_physical])
  @@index([store_id, sku_id])
  @@map("warehouse_skus")
}

model Kardex {
  id                    BigInt              @id @default(autoincrement())
  warehouse_id          BigInt?             @map("warehouse_id")
  sku_id                BigInt?             @map("sku_id")
  type_movement_id      BigInt?             @map("type_movement_id")
  status_kardex_id      BigInt?             @map("status_kardex_id")
  quantity              Int
  reference             String?             @db.VarChar(255)
  performed_by_id       BigInt?             @map("performed_by_id")
  created_at            DateTime?           @db.Timestamp(0)
  users                 User?               @relation(fields: [performed_by_id], references: [id])
  skus                  Sku?                @relation(fields: [sku_id], references: [id])
  kardex_statuses       KardexStatus?       @relation(fields: [status_kardex_id], references: [id])
  kardex_movement_types KardexMovementType? @relation(fields: [type_movement_id], references: [id])
  warehouses            Warehouse?          @relation(fields: [warehouse_id], references: [id])

  @@index([reference])
  @@index([warehouse_id, sku_id, created_at])
  @@index([sku_id, warehouse_id, created_at])
  @@index([performed_by_id], map: "kardex_performed_by_id_fkey")
  @@index([status_kardex_id], map: "kardex_status_kardex_id_fkey")
  @@index([type_movement_id], map: "kardex_type_movement_id_fkey")
  @@map("kardex")
}

model KardexMovementType {
  id                  BigInt   @id @default(autoincrement())
  code                String   @unique @db.VarChar(20)
  name                String   @db.VarChar(50)
  description         String?  @db.Text
  is_system_generated Boolean? @default(false)
  kardex              Kardex[]

  @@map("kardex_movement_types")
}

model KardexStatus {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(50)
  description String?  @db.Text
  kardex      Kardex[]

  @@map("kardex_statuses")
}

model Courier {
  id                            BigInt                       @id @default(autoincrement())
  legacy_transporter_id         BigInt?                      @map("legacy_transporter_id")
  name                          String                       @db.VarChar(255)
  country_id                    BigInt?                      @map("country_id")
  ubigeo_id                     BigInt?                      @map("ubigeo_id")
  url_image                     String?                      @db.Text
  support_phone                 String?                      @db.VarChar(50)
  support_email                 String?                      @db.VarChar(255)
  is_require_gps                Boolean?                     @default(false)
  flag_delivery_express         Boolean?                     @default(false)
  sunday_delivery               Boolean?                     @default(false)
  is_active                     Boolean?                     @default(true)
  created_at                    DateTime?                    @db.Timestamp(0)
  updated_at                    DateTime?                    @db.Timestamp(0)
  courier_coverages             CourierCoverage[]
  countries                     Country?                     @relation(fields: [country_id], references: [id])
  ubigeos                       Ubigeo?                      @relation(fields: [ubigeo_id], references: [id])
  motorized_liquidation_details MotorizedLiquidationDetail[]
  motorized_profiles            MotorizedProfile[]
  order_deliveries              OrderDelivery[]
  order_shippings               OrderShipping[]

  @@index([country_id, is_active])
  @@index([ubigeo_id], map: "couriers_ubigeo_id_fkey")
  @@map("couriers")
}

model CourierCoverage {
  id                 BigInt    @id @default(autoincrement())
  courier_id         BigInt?   @map("courier_id")
  ubigeo_id          BigInt?   @map("ubigeo_id")
  delivery_cost      Decimal?  @db.Decimal(12, 2)
  return_cost        Decimal?  @db.Decimal(12, 2)
  additional_cost    Decimal?  @db.Decimal(12, 2)
  allow_cod_override Boolean?  @default(false)
  max_cod_amount     Decimal?  @db.Decimal(12, 2)
  is_active          Boolean?  @default(true)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  couriers           Courier?  @relation(fields: [courier_id], references: [id])
  ubigeos            Ubigeo?   @relation(fields: [ubigeo_id], references: [id])

  @@unique([courier_id, ubigeo_id])
  @@index([ubigeo_id, is_active])
  @@map("courier_coverages")
}

model MotorizedProfile {
  id                  BigInt              @id @default(autoincrement())
  person_id           BigInt?             @unique @map("person_id")
  license_number      String?             @db.VarChar(50)
  vehicle_type        String?             @db.VarChar(50)
  vehicle_plate       String?             @db.VarChar(20)
  vehicle_brand       String?             @db.VarChar(50)
  vehicle_model       String?             @db.VarChar(50)
  vehicle_year        Int?
  courier_id          BigInt?             @map("courier_id")
  is_available        Boolean?            @default(true)
  shift_start         DateTime?           @db.Time(0)
  shift_end           DateTime?           @db.Time(0)
  base_rate           Decimal?            @default(5.00) @db.Decimal(10, 2)
  is_active           Boolean?            @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamp(0)
  updated_at          DateTime?           @default(now()) @db.Timestamp(0)
  motorized_coverages MotorizedCoverage[]
  couriers            Courier?            @relation(fields: [courier_id], references: [id])
  persons             Person?             @relation(fields: [person_id], references: [id])

  @@index([is_active])
  @@index([is_available])
  @@index([courier_id])
  @@map("motorized_profiles")
}

model MotorizedCoverage {
  id                      BigInt            @id @default(autoincrement())
  motorized_profile_id    BigInt?           @map("motorized_profile_id")
  ubigeo_id               BigInt?           @map("ubigeo_id")
  coverage_level          String?           @default("FULL") @db.VarChar(20)
  custom_rate             Decimal?          @db.Decimal(10, 2)
  estimated_delivery_time Int?
  is_active               Boolean?          @default(true)
  created_at              DateTime?         @default(now()) @db.Timestamp(0)
  updated_at              DateTime?         @default(now()) @db.Timestamp(0)
  motorized_profiles      MotorizedProfile? @relation(fields: [motorized_profile_id], references: [id])
  ubigeos                 Ubigeo?           @relation(fields: [ubigeo_id], references: [id])

  @@unique([motorized_profile_id, ubigeo_id])
  @@index([is_active])
  @@index([ubigeo_id])
  @@map("motorized_coverages")
}

model Liquidation {
  id                       BigInt                   @id @default(autoincrement())
  store_id                 BigInt?                  @map("store_id")
  period_start             DateTime                 @db.Date
  period_end               DateTime                 @db.Date
  status_id                BigInt?                  @map("status_id")
  total_orders             Int
  total_delivered          Int
  total_cash               Decimal                  @db.Decimal(14, 2)
  total_transfer           Decimal                  @db.Decimal(14, 2)
  total_pos                Decimal                  @db.Decimal(14, 2)
  commission_amount        Decimal                  @db.Decimal(14, 2)
  net_amount               Decimal                  @db.Decimal(14, 2)
  currency_code            String                   @db.Char(3)
  created_at               DateTime?                @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                @default(now()) @db.Timestamp(0)
  liquidation_activity_log LiquidationActivityLog[]
  liquidation_details      LiquidationDetail[]
  liquidation_exports      LiquidationExport[]
  liquidation_statuses     LiquidationStatus?       @relation(fields: [status_id], references: [id])
  stores                   Store?                   @relation(fields: [store_id], references: [id])

  @@index([currency_code])
  @@index([store_id, period_start, period_end, status_id])
  @@index([store_id, period_start, period_end])
  @@index([store_id, status_id])
  @@index([status_id], map: "liquidations_status_id_fkey")
  @@map("liquidations")
}

model LiquidationDetail {
  id                BigInt       @id @default(autoincrement())
  liquidation_id    BigInt?      @map("liquidation_id")
  order_id          BigInt?      @map("order_id")
  sku_id            BigInt?      @map("sku_id")
  quantity          Int
  unit_price        Decimal      @db.Decimal(12, 2)
  total_amount      Decimal      @db.Decimal(12, 2)
  commission_rate   Decimal      @db.Decimal(5, 4)
  commission_amount Decimal      @db.Decimal(12, 2)
  net_amount        Decimal      @db.Decimal(12, 2)
  created_at        DateTime?    @default(now()) @db.Timestamp(0)
  liquidations      Liquidation? @relation(fields: [liquidation_id], references: [id])
  orders            Order?       @relation(fields: [order_id], references: [id])
  skus              Sku?         @relation(fields: [sku_id], references: [id])

  @@index([liquidation_id])
  @@index([order_id])
  @@index([sku_id])
  @@map("liquidation_details")
}

model MotorizedLiquidation {
  id                              BigInt                         @id @default(autoincrement())
  store_id                        BigInt?                        @map("store_id")
  motorized_person_id             BigInt?                        @map("motorized_person_id")
  period_start                    DateTime                       @db.Date
  period_end                      DateTime                       @db.Date
  status_id                       BigInt?                        @map("status_id")
  total_deliveries                Int?                           @default(0)
  total_delivered                 Int?                           @default(0)
  total_failed                    Int?                           @default(0)
  total_incidents                 Int?                           @default(0)
  subtotal_commission             Decimal                        @db.Decimal(14, 2)
  total_discounts                 Decimal?                       @default(0.00) @db.Decimal(14, 2)
  net_amount                      Decimal                        @db.Decimal(14, 2)
  currency_code                   String                         @db.Char(3)
  created_at                      DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at                      DateTime?                      @default(now()) @db.Timestamp(0)
  motorized_liquidation_details   MotorizedLiquidationDetail[]
  motorized_liquidation_evidences MotorizedLiquidationEvidence[]
  persons                         Person?                        @relation(fields: [motorized_person_id], references: [id])
  liquidation_statuses            LiquidationStatus?             @relation(fields: [status_id], references: [id])
  stores                          Store?                         @relation(fields: [store_id], references: [id])

  @@index([store_id, motorized_person_id, period_start, period_end])
  @@index([motorized_person_id, created_at])
  @@index([status_id])
  @@map("motorized_liquidations")
}

model MotorizedLiquidationDetail {
  id                       BigInt                @id @default(autoincrement())
  motorized_liquidation_id BigInt?               @map("motorized_liquidation_id")
  order_delivery_id        BigInt?               @map("order_delivery_id")
  delivery_fee             Decimal               @db.Decimal(12, 2)
  delivery_date            DateTime              @db.Timestamp(0)
  delivery_status_code     String                @db.VarChar(20)
  base_commission          Decimal               @db.Decimal(12, 2)
  additional_commission    Decimal?              @default(0.00) @db.Decimal(12, 2)
  total_commission         Decimal               @db.Decimal(12, 2)
  incident_discount        Decimal?              @default(0.00) @db.Decimal(12, 2)
  net_commission           Decimal               @db.Decimal(12, 2)
  order_id                 BigInt?               @map("order_id")
  courier_id               BigInt?               @map("courier_id")
  notes                    String?               @db.Text
  created_at               DateTime?             @default(now()) @db.Timestamp(0)
  orderShippingId          BigInt?
  motorized_incidents      MotorizedIncident[]
  couriers                 Courier?              @relation(fields: [courier_id], references: [id])
  motorized_liquidations   MotorizedLiquidation? @relation(fields: [motorized_liquidation_id], references: [id])
  OrderShipping            OrderShipping?        @relation(fields: [orderShippingId], references: [id])
  order_deliveries         OrderDelivery?        @relation(fields: [order_delivery_id], references: [id])
  orders                   Order?                @relation(fields: [order_id], references: [id])

  @@index([order_delivery_id])
  @@index([motorized_liquidation_id])
  @@index([courier_id], map: "motorized_liquidation_details_courier_id_fkey")
  @@index([orderShippingId], map: "motorized_liquidation_details_orderShippingId_fkey")
  @@index([order_id], map: "motorized_liquidation_details_order_id_fkey")
  @@map("motorized_liquidation_details")
}

model BankAccount {
  id                BigInt      @id @default(autoincrement())
  owner_type        String      @db.VarChar(20)
  owner_id          BigInt?     @map("owner_id")
  bank_code         String      @db.VarChar(50)
  account_number    String      @db.VarChar(100)
  cci               String?     @db.VarChar(20)
  account_type_id   BigInt      @map("account_type_id")
  currency_code     String?     @default("PEN") @db.Char(3)
  holder_name       String      @db.VarChar(255)
  holder_doc_type   String?     @db.VarChar(20)
  holder_doc_number String?     @db.VarChar(50)
  is_primary        Boolean?    @default(false)
  is_active         Boolean?    @default(true)
  created_at        DateTime?   @default(now()) @db.Timestamp(0)
  updated_at        DateTime?   @default(now()) @db.Timestamp(0)
  storeId           BigInt?
  account_types     AccountType @relation(fields: [account_type_id], references: [id])
  Store             Store?      @relation(fields: [storeId], references: [id])

  @@index([owner_type, owner_id])
  @@index([bank_code, account_number])
  @@index([account_type_id], map: "bank_accounts_account_type_id_fkey")
  @@index([storeId], map: "bank_accounts_storeId_fkey")
  @@map("bank_accounts")
}

model PaymentMethod {
  id                              BigInt                         @id @default(autoincrement())
  code                            String                         @unique @db.VarChar(20)
  name                            String                         @db.VarChar(50)
  description                     String?                        @db.Text
  country_id                      BigInt?                        @map("country_id")
  currency_code                   String                         @db.Char(3)
  is_active                       Boolean?                       @default(true)
  created_at                      DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at                      DateTime?                      @default(now()) @db.Timestamp(0)
  motorized_liquidation_evidences MotorizedLiquidationEvidence[]
  order_payments                  OrderPayment[]
  countries                       Country?                       @relation(fields: [country_id], references: [id])

  @@index([country_id, is_active])
  @@index([currency_code])
  @@index([code])
  @@map("payment_methods")
}

model Catalog {
  id         BigInt    @id @default(autoincrement())
  store_id   BigInt?   @map("store_id")
  name       String?   @db.VarChar(255)
  is_public  Boolean?  @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  stores     Store?    @relation(fields: [store_id], references: [id])
  products   Product[]

  @@index([store_id])
  @@map("catalogs")
}

model Category {
  id         BigInt     @id @default(autoincrement())
  store_id   BigInt?    @map("store_id")
  parent_id  BigInt?    @map("parent_id")
  name       String?    @db.VarChar(255)
  is_active  Boolean?   @default(true)
  created_at DateTime?  @db.Timestamp(0)
  updated_at DateTime?  @db.Timestamp(0)
  parent     Category?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryParent")
  stores     Store?     @relation(fields: [store_id], references: [id])
  products   Product[]

  @@index([store_id])
  @@index([store_id, is_active])
  @@index([parent_id])
  @@map("categories")
}

model Role {
  id                BigInt            @id @default(autoincrement())
  name              String            @unique @db.VarChar(50)
  description       String?           @db.VarChar(255)
  is_active         Boolean?          @default(true)
  created_at        DateTime?         @db.Timestamp(0)
  role_permissions  RolePermission[]
  store_memberships StoreMembership[]

  @@map("roles")
}

model Permission {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique @db.VarChar(50)
  name             String           @db.VarChar(100)
  type_id          BigInt?          @map("type_id")
  resource         String?          @db.VarChar(50)
  sub_resource     String?          @db.VarChar(50)
  description      String?          @db.Text
  is_active        Boolean?         @default(true)
  permission_types PermissionType?  @relation(fields: [type_id], references: [id])
  role_permissions RolePermission[]

  @@index([type_id], map: "permissions_type_id_fkey")
  @@map("permissions")
}

model PermissionType {
  id          BigInt       @id @default(autoincrement())
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(50)
  permissions Permission[]

  @@map("permission_types")
}

model RolePermission {
  role_id       BigInt
  permission_id BigInt
  permissions   Permission @relation(fields: [permission_id], references: [id])
  roles         Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@index([permission_id], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model StoreMembership {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt?   @map("user_id")
  store_id      BigInt?   @map("store_id")
  role_id       BigInt?   @map("role_id")
  is_owner      Boolean?  @default(false)
  employee_code String?   @db.VarChar(50)
  hire_date     DateTime? @db.Date
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  roles         Role?     @relation(fields: [role_id], references: [id])
  stores        Store?    @relation(fields: [store_id], references: [id])
  users         User?     @relation(fields: [user_id], references: [id])

  @@unique([user_id, store_id])
  @@index([is_active])
  @@index([store_id, role_id])
  @@index([role_id], map: "store_memberships_role_id_fkey")
  @@map("store_memberships")
}

model Wallet {
  id                  BigInt              @id @default(autoincrement())
  store_id            BigInt?             @map("store_id")
  currency_code       String              @db.Char(3)
  balance             Decimal?            @default(0.00) @db.Decimal(14, 2)
  owner_type          String?             @default("STORE") @db.VarChar(20)
  owner_id            BigInt?             @map("owner_id")
  version             Int?                @default(1)
  is_active           Boolean?            @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamp(0)
  updated_at          DateTime?           @default(now()) @db.Timestamp(0)
  wallet_transactions WalletTransaction[]
  stores              Store?              @relation(fields: [store_id], references: [id])

  @@unique([store_id, owner_type, owner_id])
  @@index([version])
  @@map("wallets")
}

model WalletTransaction {
  id               BigInt    @id @default(autoincrement())
  wallet_id        BigInt?   @map("wallet_id")
  transaction_type String    @db.VarChar(20)
  status           String?   @default("PENDING") @db.VarChar(20)
  amount           Decimal   @db.Decimal(14, 2)
  balance_after    Decimal   @db.Decimal(14, 2)
  reference_type   String?   @db.VarChar(50)
  reference_id     BigInt?   @map("reference_id")
  description      String?   @db.Text
  metadata         Json?
  performed_by_id  BigInt?   @map("performed_by_id")
  previous_version Int
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  users            User?     @relation(fields: [performed_by_id], references: [id])
  wallets          Wallet?   @relation(fields: [wallet_id], references: [id])

  @@index([wallet_id, status, created_at])
  @@index([reference_type, reference_id])
  @@index([status])
  @@index([wallet_id, created_at])
  @@index([previous_version])
  @@index([performed_by_id], map: "wallet_transactions_performed_by_id_fkey")
  @@map("wallet_transactions")
}

model Integration {
  id                   BigInt               @id @default(autoincrement())
  store_id             BigInt?              @map("store_id")
  type                 String               @db.VarChar(50)
  is_active            Boolean?             @default(true)
  config               Json?
  created_at           DateTime?            @default(now()) @db.Timestamp(0)
  updated_at           DateTime?            @default(now()) @db.Timestamp(0)
  integration_webhooks IntegrationWebhook[]
  stores               Store?               @relation(fields: [store_id], references: [id])

  @@unique([store_id, type])
  @@map("integrations")
}

model IntegrationWebhook {
  id             BigInt       @id @default(autoincrement())
  integration_id BigInt?      @map("integration_id")
  event_type     String       @db.VarChar(100)
  payload        Json?
  processed_at   DateTime?    @db.Timestamp(0)
  created_at     DateTime?    @default(now()) @db.Timestamp(0)
  integrations   Integration? @relation(fields: [integration_id], references: [id])

  @@index([event_type, processed_at])
  @@index([integration_id, event_type])
  @@map("integration_webhooks")
}

model IncidentType {
  id                  BigInt              @id @default(autoincrement())
  store_id            BigInt?             @map("store_id")
  code                String              @unique @db.VarChar(20)
  label               String              @db.VarChar(100)
  description         String?             @db.Text
  default_discount    Decimal?            @default(0.00) @db.Decimal(12, 2)
  is_active           Boolean?            @default(true)
  created_at          DateTime?           @default(now()) @db.Timestamp(0)
  updated_at          DateTime?           @default(now()) @db.Timestamp(0)
  stores              Store?              @relation(fields: [store_id], references: [id])
  motorized_incidents MotorizedIncident[]

  @@index([code])
  @@index([store_id])
  @@map("incident_types")
}

model MotorizedIncident {
  id                              BigInt                      @id @default(autoincrement())
  motorized_liquidation_detail_id BigInt?                     @map("motorized_liquidation_detail_id")
  incident_type_id                BigInt?                     @map("incident_type_id")
  description                     String?                     @db.Text
  discount_amount                 Decimal                     @db.Decimal(12, 2)
  evidence_url                    String?                     @db.Text
  evidence_metadata               Json?
  reported_by_id                  BigInt?                     @map("reported_by_id")
  resolved_by_id                  BigInt?                     @map("resolved_by_id")
  status                          String?                     @default("PENDING") @db.VarChar(20)
  created_at                      DateTime?                   @default(now()) @db.Timestamp(0)
  updated_at                      DateTime?                   @default(now()) @db.Timestamp(0)
  incident_types                  IncidentType?               @relation(fields: [incident_type_id], references: [id])
  motorized_liquidation_details   MotorizedLiquidationDetail? @relation(fields: [motorized_liquidation_detail_id], references: [id])
  reported_by                     User?                       @relation("reportedBy", fields: [reported_by_id], references: [id])
  resolved_by                     User?                       @relation("resolvedBy", fields: [resolved_by_id], references: [id])

  @@index([motorized_liquidation_detail_id])
  @@index([status])
  @@index([incident_type_id])
  @@index([reported_by_id], map: "motorized_incidents_reported_by_id_fkey")
  @@index([resolved_by_id], map: "motorized_incidents_resolved_by_id_fkey")
  @@map("motorized_incidents")
}

model MotorizedLiquidationEvidence {
  id                       BigInt                @id @default(autoincrement())
  motorized_liquidation_id BigInt?               @map("motorized_liquidation_id")
  voucher_number           String                @db.VarChar(50)
  voucher_date             DateTime              @db.Date
  amount                   Decimal               @db.Decimal(12, 2)
  file_url                 String?               @db.Text
  payment_method_id        BigInt?               @map("payment_method_id")
  operation_code           String?               @unique @db.VarChar(50)
  created_by_id            BigInt?               @map("created_by_id")
  created_at               DateTime?             @default(now()) @db.Timestamp(0)
  updated_at               DateTime?             @default(now()) @db.Timestamp(0)
  users                    User?                 @relation(fields: [created_by_id], references: [id])
  motorized_liquidations   MotorizedLiquidation? @relation(fields: [motorized_liquidation_id], references: [id])
  payment_methods          PaymentMethod?        @relation(fields: [payment_method_id], references: [id])

  @@index([motorized_liquidation_id])
  @@index([created_by_id])
  @@index([payment_method_id], map: "motorized_liquidation_evidences_payment_method_id_fkey")
