<file path="serverless.yml">
service: aliclik-migration

frameworkVersion: '3'

provider:
  name: aws
  runtime: nodejs20.x
  region: ${env:AWS_REGION, 'us-east-1'}
  stage: ${opt:stage, 'dev'}
  timeout: 30
  memorySize: 512
  environment:
    PRISMA_QUERY_ENGINE_LIBRARY: /var/task/libquery_engine-rhel-openssl-3.0.x.so.node
    DATABASE_URL: ${env:DATABASE_URL, ''}
    AURORA_DATABASE_URL: ${env:AURORA_DATABASE_URL, ''}
    NODE_ENV: ${env:NODE_ENV, 'development'}
    LOG_LEVEL: ${env:LOG_LEVEL, 'info'}
    SQS_QUEUE_URL: ${env:SQS_QUEUE_URL, 'https://sqs.us-east-1.amazonaws.com/417609992114/User-migration-queue-v2'}
    SQS_DLQ_URL: ${env:SQS_DLQ_URL, 'https://sqs.us-east-1.amazonaws.com/417609992114/user-migration-dlq-v2'}

  iam:
    role:
      statements:
        - Effect: Allow
          Action:
            - sqs:ReceiveMessage
            - sqs:DeleteMessage
            - sqs:GetQueueAttributes
            - sqs:SendMessage
          Resource:
            - ${env:SQS_QUEUE_ARN, 'arn:aws:sqs:us-east-1:417609992114:User-migration-queue-v2'}
            - ${env:SQS_DLQ_ARN, 'arn:aws:sqs:us-east-1:417609992114:user-migration-dlq-v2'}

plugins:
  - serverless-esbuild
  - serverless-offline
  - serverless-dotenv-plugin

custom:
  esbuild:
    bundle: true
    minify: false
    sourcemap: true
    target: node20
    packager: pnpm

package:
  individually: false
  patterns:
    - 'libquery_engine-rhel-openssl-3.0.x.so.node'
    - 'prisma/schema.prisma'

functions:
  processSqsMigration:
    handler: src/handlers/processSqsMigration.handler
    events:
      - sqs:
          arn: ${env:SQS_QUEUE_ARN, 'arn:aws:sqs:us-east-1:417609992114:User-migration-queue-v2'}
          batchSize: 10
          maximumBatchingWindow: 60
          functionResponseType: ReportBatchItemFailures
</file>

